{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-swiper-element": {
      "projectType": "library",
      "root": "projects/ng-swiper-element",
      "sourceRoot": "projects/ng-swiper-element/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ng-swiper-element/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-swiper-element/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-swiper-element/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "assets": [],
            "styles": ["projects/ng-swiper-element/src/styles/styles.css"],
            "tsConfig": "projects/ng-swiper-element/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "styles": ["projects/ng-swiper-element/src/styles/styles.css"],
            "configDir": "projects/ng-swiper-element/.storybook",
            "browserTarget": "storybook:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "projects/ng-swiper-element"],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "styles": ["projects/ng-swiper-element/src/styles/styles.css"],
            "configDir": "projects/ng-swiper-element/.storybook",
            "browserTarget": "storybook:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "projects/ng-swiper-element"],
            "outputDir": "storybook-static"
          }
        }
      }
    },
    "storybook": {
      "projectType": "application",
      "root": "stories",
      "sourceRoot": "stories",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/storybook-browser",
            "index": "projects/ng-swiper-element/.storybook/preview-head.html",
            "main": "projects/ng-swiper-element/src/public-api.ts",
            "polyfills": "projects/ng-swiper-element/polyfills.ts",
            "tsConfig": "projects/ng-swiper-element/.storybook/tsconfig.json",
            "assets": [
              {
                "glob": "README.md",
                "input": "projects/ng-swiper-element",
                "output": "/"
              },
              {
                "glob": "**/**/*.min.css",
                "input": "node_modules/swiper",
                "output": "/swiper/css"
              }
            ],
            "styles": ["projects/ng-swiper-element/src/styles/styles.css"],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
