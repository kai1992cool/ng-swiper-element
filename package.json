{
  "name": "ng-swiper-element",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --project ng-swiper-element",
    "test": "ng test",
    "compodoc": "npx compodoc -p /projects/ng-swiper-element/.storybook/tsconfig.doc.json -s",
    "storybook": "ng run ng-swiper-element:storybook",
    "build-website": "ng build ng-swiper-element-demo && cp projects/ng-swiper-element/README.md dist/ng-swiper-element-demo/browser/README.md && cp LICENSE dist/ng-swiper-element-demo/LICENSE",
    "serve:ssr:ng-swiper-element-demo": "node dist/ng-swiper-element-demo/server/server.mjs",
    "build-storybook": "ng run ng-swiper-element:build-storybook",
    "patch": "npm version patch --depth 9999 && cd projects/ng-swiper-element && npm version patch --depth 9999 && git add z, . && git commit -m \"Patch version increased\" && cd ../..",
    "publish": "npm run build && cp projects/ng-swiper-element/README.md LICENSE dist/ng-swiper-element && cd dist/ng-swiper-element && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.38",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "marked": "^18.1.0",
    "rxjs": "~7.8.0",
    "swiper": "^14.2.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.0",
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular-devkit/core": "^20.3.0",
    "@angular/build": "^20.3.38",
    "@angular/cli": "^20.3.38",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@compodoc/compodoc": "latest",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "postcss": "^8.5.29",
    "storybook": "^10.6.1",
    "typescript": "~5.9.2"
  }
}
