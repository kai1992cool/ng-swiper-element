{
  "name": "ng-swiper-element",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --project ng-swiper-element",
    "test": "ng test",
    "compodoc": "npx compodoc -p /projects/ng-swiper-element/.storybook/tsconfig.doc.json -s",
    "storybook": "ng run ng-swiper-element:storybook",
    "build-website": "ng build ng-swiper-element-demo && cp projects/ng-swiper-element/README.md dist/ng-swiper-element-demo/browser/README.md && cp LICENSE dist/ng-swiper-element-demo/LICENSE",
    "serve:ssr:ng-swiper-element-demo": "node dist/ng-swiper-element-demo/server/server.mjs",
    "build-storybook": "ng run ng-swiper-element:build-storybook",
    "patch": "npm version patch --depth 9999 && cd projects/ng-swiper-element && npm version patch --depth 9999 && git add z, . && git commit -m \"Patch version increased\" && cd ../..",
    "publish": "npm run build && cp projects/ng-swiper-element/README.md LICENSE dist/ng-swiper-element && cd dist/ng-swiper-element && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "swiper": "^14.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "^16.2.16",
    "@angular/compiler-cli": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^16.2.0",
    "typescript": "~5.1.3",
    "storybook": "^8.6.14",
    "@storybook/angular": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/manager": "^8.6.14",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@types/node": "^20",
    "@angular-devkit/architect": "^0.1602.0",
    "@angular-devkit/core": "^16.2.0",
    "@compodoc/compodoc": "latest"
  }
}
