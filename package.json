{
  "name": "ng-swiper-element",
  "version": "22.0.0",
  "description": "Angular wrapper for Swiper Element with components, directives, and event bindings for responsive carousels.",
  "keywords": [
    "angular",
    "swiper",
    "swiperjs",
    "angular-swiper",
    "swiper-angular",
    "swiper-element",
    "angular-carousel",
    "carousel",
    "slider",
    "web-components",
    "typescript"
  ],
  "homepage": "https://kai1992cool.github.io/ng-swiper-element/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kai1992cool/ng-swiper-element.git",
    "directory": "projects/ng-swiper-element"
  },
  "bugs": {
    "url": "https://github.com/kai1992cool/ng-swiper-element/issues"
  },
  "license": "MIT",
  "author": "Naren",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --project ng-swiper-element",
    "test": "ng test",
    "compodoc": "npx compodoc -p /projects/ng-swiper-element/.storybook/tsconfig.doc.json -s",
    "storybook": "ng run ng-swiper-element:storybook",
    "build-website": "ng build ng-swiper-element-demo && cp projects/ng-swiper-element/README.md dist/ng-swiper-element-demo/browser/README.md && cp LICENSE dist/ng-swiper-element-demo/LICENSE",
    "serve:ssr:ng-swiper-element-demo": "node dist/ng-swiper-element-demo/server/server.mjs",
    "build-storybook": "ng run ng-swiper-element:build-storybook",
    "patch": "cd projects/ng-swiper-element && npm version patch --depth 9999 && cd ../..",
    "publish-package": "node scripts/publish-angular.mjs",
    "publish": "npm run build && cp projects/ng-swiper-element/README.md LICENSE dist/ng-swiper-element && cd dist/ng-swiper-element && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "swiper": "^14.2.0",
    "express": "^5.1.0",
    "marked": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "storybook": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "postcss": "^8.5.29",
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular-devkit/architect": "^0.2202.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@compodoc/compodoc": "latest"
  }
}
