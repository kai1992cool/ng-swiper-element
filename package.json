{
  "name": "ng-swiper-element",
  "version": "14.0.0",
  "description": "Angular wrapper for Swiper Element with components, directives, and event bindings for responsive carousels.",
  "keywords": [
    "angular",
    "swiper",
    "swiperjs",
    "angular-swiper",
    "swiper-angular",
    "swiper-element",
    "angular-carousel",
    "carousel",
    "slider",
    "web-components",
    "typescript"
  ],
  "homepage": "https://kai1992cool.github.io/ng-swiper-element/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kai1992cool/ng-swiper-element.git",
    "directory": "projects/ng-swiper-element"
  },
  "bugs": {
    "url": "https://github.com/kai1992cool/ng-swiper-element/issues"
  },
  "license": "MIT",
  "author": "Naren",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --project ng-swiper-element",
    "test": "ng test",
    "compodoc": "npx compodoc -p /projects/ng-swiper-element/.storybook/tsconfig.doc.json -s",
    "storybook": "ng run ng-swiper-element:storybook",
    "build-website": "ng build ng-swiper-element-demo && cp projects/ng-swiper-element/README.md dist/ng-swiper-element-demo/browser/README.md && cp LICENSE dist/ng-swiper-element-demo/LICENSE",
    "serve:ssr:ng-swiper-element-demo": "node dist/ng-swiper-element-demo/server/server.mjs",
    "build-storybook": "ng run ng-swiper-element:build-storybook",
    "patch": "cd projects/ng-swiper-element && npm version patch --depth 9999 && cd ../..",
    "publish-package": "node scripts/publish-angular.mjs",
    "publish": "npm run build && cp projects/ng-swiper-element/README.md LICENSE dist/ng-swiper-element && cd dist/ng-swiper-element && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.2.0",
    "@angular/common": "^14.2.0",
    "@angular/compiler": "^14.2.0",
    "@angular/core": "^14.2.0",
    "@angular/forms": "^14.2.0",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.2.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "~7.5.0",
    "swiper": "^9.4.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1402.0",
    "@angular-devkit/build-angular": "^14.2.13",
    "@angular-devkit/core": "^14.2.0",
    "@angular/cli": "~14.2.13",
    "@angular/compiler-cli": "^14.2.0",
    "@compodoc/compodoc": "1.1.19",
    "@storybook/test": "^7.6.24",
    "@storybook/manager": "^7.6.24",
    "@storybook/addon-a11y": "^7.6.24",
    "@storybook/addon-docs": "^7.6.24",
    "@storybook/angular": "^7.6.24",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^16.18.0",
    "@types/react": "^18.3.18",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^14.2.0",
    "storybook": "^7.6.24",
    "typescript": "~4.7.2"
  }
}
